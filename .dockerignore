# Python — reinstalled inside the image
backend/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Secrets — never bake into image
backend/.env

# Node — reinstalled in stage 1
frontend/node_modules/
frontend/dist/

# Version control
.git/
.gitignore

# OS / editor
.DS_Store
Thumbs.db

# Unlike measles-hotspot, data/*.duckdb is NOT baked in from a committed
# file -- it's generated fresh by seed/ETL RUN steps during the Docker
# build itself (see Dockerfile). Exclude any local dev copy so a stale
# local DB can never accidentally get copied into the image instead.
data/*.duckdb
